# Required backend configuration
MONGODB_URI=mongodb://127.0.0.1:27017/personality_predictor
JWT_SECRET=replace-with-a-long-random-secret

# Optional server and frontend configuration
PORT=5000
FRONTEND_URL=http://localhost:3000
NODE_ENV=development

# Optional OAuth credentials (required only for the matching sign-in provider)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FB_APP_ID=
FB_APP_SECRET=
